# Telink W91 RF configuration options

config IEEE802154_TELINK_W91
	bool "Telink W91 RF driver"
	default y
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	depends on DT_HAS_TELINK_W91_ZB_ENABLED

if IEEE802154_TELINK_W91

config IEEE802154_W91_DELAY_TRX_ACC
	int "Clock accuracy for delayed operations"
	default 20
	help
	  Accuracy of the clock used for scheduling radio delayed operations (delayed transmission
	  or delayed reception), in ppm.

endif # IEEE802154_TELINK_W91
