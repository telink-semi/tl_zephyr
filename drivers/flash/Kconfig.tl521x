config SOC_FLASH_TELINK_TL521X
	bool "Telink Semiconductor TL521X flash driver"
	default y
	depends on DT_HAS_TELINK_TL521X_FLASH_CONTROLLER_ENABLED
	select FLASH_HAS_PAGE_LAYOUT
	select FLASH_HAS_DRIVER_ENABLED
	help
	  Enables Telink TL521X flash driver.
