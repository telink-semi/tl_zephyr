# Telink TL521x-series GPIO configuration options

config GPIO_TELINK_TL521X
	bool "Telink TL521x-series GPIO driver"
	default y
	depends on DT_HAS_TELINK_TL521X_GPIO_ENABLED
	help
	  Enables the TL521x-series GPIO driver.
