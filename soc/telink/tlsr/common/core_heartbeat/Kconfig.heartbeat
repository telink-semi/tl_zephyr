config TELINK_CORE_HEARTBEAT
	bool "Telink intercore heartbeat"
	default y
	depends on !PM
	help
		This option enables Telink heartbeat messages between cores.

if TELINK_CORE_HEARTBEAT

config CORE_HEARTBEAT_TELINK_TIMEOUT_MS
	int "Heartbeat signal interval, ms"
	default 2000
	help
	  This option sets heartbeat timeout in mS.

endif # TELINK_CORE_HEARTBEAT
