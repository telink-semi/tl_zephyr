choice APPLICATION_TYPE
	default APPLICATION_TYPE_ST25DV_MAILBOX
	prompt "Application type"

config APPLICATION_TYPE_ST25DV_MAILBOX
	bool "Application type ST25DV mailbox"
config APPLICATION_TYPE_ST25DV_STATIC_TAG_ADD
	bool "Application type ST25DV static tag publish"
config APPLICATION_TYPE_ST25DV_STATIC_TAG_RM
	bool "Application type ST25DV static tag withdraw"

endchoice

source "Kconfig.zephyr"
