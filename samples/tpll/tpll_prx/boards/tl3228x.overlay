/* Memory layout override (values match board defaults, kept for clarity) */
&ram_ilm {
	reg = <0x00000000 0x00010000>;
};

&ram_dlm {
	reg = <0x00080000 0x00018000>;
};

&n22_ram_ilm {
	reg = <0x50000000 0x00028000>;
};

&n22_ram_dlm {
	reg = <0x50080000 0x00010000>;
};


&power {
	power-mode = "LDO_1P25_LDO_1P8";
};
