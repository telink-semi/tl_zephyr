#include <zephyr/dt-bindings/pinctrl/tl322x-pinctrl.h>

/ {
	chosen {
		/* Use UART1 for HCI transport (DT_CHOSEN(uart1) in sample) */
		uart1 = &uart1;
	};
};

/* Memory layout override (values match board defaults, kept for clarity) */
&ram_ilm {
	reg = <0x00000000 0x00010000>;
};

&ram_dlm {
	reg = <0x00080000 0x00018000>;
};

&power {
	power-mode = "LDO_1P25_LDO_1P8";
};

/* Additional pinctrl states: UART0 remapped to PC0/PC1, UART1 remapped to PB0/PB1 */


&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_tx_pc6_default &uart1_rx_pc7_default>;
	pinctrl-names = "default";
};
